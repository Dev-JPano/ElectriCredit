# ==================================================
# AI PROVIDERS
# Multiple API keys can be separated by commas
# ==================================================
GROQ_API_KEYS=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.1-8b-instant

# --------------------------------------------------
# EMAIL - SMTP
# --------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=jacpano@gmail.com
# For Gmail, SMTP_PASS must be a Google App Password, not your normal Gmail password.
SMTP_PASS=your_email_password_or_app_password
SMTP_FROM_NAME=ElectriCredit
SMTP_FROM_EMAIL=jacpano@gmail.com


# --------------------------------------------------
# SMS - UniSMS
# --------------------------------------------------
UNISMS_API_KEY=uni_api
UNISMS_SENDER_ID=ElectriCredit
UNISMS_API_URL=https://unismsapi.com/api/sms



# --------------------------------------------------
# PROFILE / OTP DEVELOPMENT FLAGS
# PROFILE_OTP_ECHO=true returns dev_pin in API response.
# Turn it false before demo/production.
# --------------------------------------------------
PROFILE_OTP_ALLOW_LOCAL_FALLBACK=true
PROFILE_OTP_ECHO=true
PROFILE_REQUIRE_OTP_FOR_SELF_UPDATE=true
PROFILE_REQUIRE_OTP_FOR_MANAGED_UPDATE=false
PROFILE_REQUIRE_CONFIRMATION_FOR_OWNER_DELETE=true
